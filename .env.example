# DEFAULT: isolated demo. No hardware writes, no use of actual account secrets.
MOCK_MODE=true
RUN_SCHEDULER=true
ALLOW_DEVICE_WRITES=false
EXPORT_ENABLED=false
EXPORT_LIMIT_KW=0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Europe/London
PLAN_HOUR_LOCAL=22
DATABASE_PATH=/data/home-ai.sqlite

# Household / hardware assumptions (verify before using any control features)
PV_KWP=6.86
BATTERY_CAPACITY_KWH=11.0
BATTERY_MIN_SOC=10
BATTERY_MAX_SOC=100
BATTERY_MAX_CHARGE_KW=5
BATTERY_MAX_DISCHARGE_KW=5
GRID_IMPORT_LIMIT_KW=10
ROUNDTRIP_CHARGE_EFF=0.95
ROUNDTRIP_DISCHARGE_EFF=0.95
DEGRADATION_GBP_PER_KWH=0.015
PV_FORECAST_FACTOR=0.78

# Demo prices only (GBP/kWh). Never consider these verified account tariffs.
DEMO_IMPORT_OFFPEAK_GBP=0.08
DEMO_IMPORT_PEAK_GBP=0.30
DEMO_EXPORT_GBP=0.12

# FoxCloud private-token API; leave empty in mock mode.
FOX_API_TOKEN=
FOX_DEVICE_SN=
FOX_API_BASE=https://www.foxesscloud.com

# Octopus REST tariff rate lookup; use real product + tariff IDs in live mode.
OCTOPUS_API_KEY=
OCTOPUS_IMPORT_PRODUCT=
OCTOPUS_IMPORT_TARIFF=
OCTOPUS_EXPORT_PRODUCT=
OCTOPUS_EXPORT_TARIFF=

# OpenAI is only needed for conversational agent and future optional image analysis.
VISION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Long random secret used in X-HomeAI-Token by UniFi Alarm Manager webhook.
PROTECT_WEBHOOK_TOKEN=change-me-before-live
# Set to Mac LAN IP when ready to accept Protect webhooks; never 0.0.0.0 on an untrusted network.
WEBHOOK_BIND_IP=127.0.0.1
# Keep localhost during development; for VPN/LAN browsing use your Mini PC LAN IP.
DASHBOARD_BIND_IP=127.0.0.1

# Internal MCP endpoints — backend server network
MCP_FOXESS_URL=http://mcp-foxess:8101/mcp
MCP_OCTOPUS_URL=http://mcp-octopus:8102/mcp
MCP_UNIFI_URL=http://mcp-unifi:8103/mcp
MCP_OPTIMISER_URL=http://mcp-optimiser:8104/mcp
